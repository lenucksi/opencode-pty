{
  "name": "@lenucksi/agentterm",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "version": "1.0.1",
  "description": "PTY sessions for coding agents - an OpenCode plugin, an MCP server for terminal sessions, and a standalone web terminal (tmux, but agent-native)",
  "author": "lenucksi",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mcp",
    "mcp-server",
    "ai-agents",
    "agent",
    "pty",
    "pseudo-terminal",
    "terminal",
    "terminal-multiplexer",
    "tmux",
    "tmux-alternative",
    "claude",
    "claude-code",
    "background-process",
    "interactive",
    "cli",
    "shell",
    "dev-server",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenucksi/opencode-pty.git"
  },
  "bugs": {
    "url": "https://github.com/lenucksi/opencode-pty/issues"
  },
  "homepage": "https://github.com/lenucksi/opencode-pty#readme",
  "files": [
    "dist",
    "patches"
  ],
  "bin": {
    "agentterm-mcp": "dist/src/mcp/entry.js",
    "agentterm-web": "dist/src/web/entry.js",
    "opencode-pty-mcp": "dist/src/mcp/entry.js",
    "opencode-pty-web": "dist/src/web/entry.js"
  },
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "exports": {
    "./v2": {
      "types": "./dist/src/v2/index.d.ts",
      "default": "./dist/src/v2/index.js"
    },
    "./v2/tui": {
      "types": "./dist/src/tui/index.d.ts",
      "default": "./dist/src/tui/index.js"
    },
    "./tui": {
      "types": "./dist/src/tui/index.d.ts",
      "default": "./dist/src/tui/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    },
    "./*/*": {
      "types": "./dist/src/*/*.d.ts",
      "default": "./dist/src/*/*.js"
    },
    "./*/*/*": {
      "types": "./dist/src/*/*/*.d.ts",
      "default": "./dist/src/*/*/*.js"
    },
    "./*/*/*/*": {
      "types": "./dist/src/*/*/*/*.d.ts",
      "default": "./dist/src/*/*/*/*.js"
    }
  },
  "scripts": {
    "typecheck": "bun check",
    "unittest": "bun test --max-concurrency=1",
    "test:llm": "bun test/llm/run.ts",
    "test:daemon": "bun test/llm/daemon-survival-run.ts",
    "test:coverage": "bun test --coverage --max-concurrency=1",
    "test:e2e": "PW_DISABLE_TS_ESM=1 NODE_ENV=test bun --bun playwright test",
    "test:local": "bun scripts/test-local.ts",
    "test:all": "bun run test:local",
    "aislop": "bunx aislop@0.16.1 scan . --json",
    "aislop:check": "bun scripts/check-aislop.ts",
    "deps:check": "bun scripts/check-dependencies.ts",
    "secrets:gitleaks": "gitleaks git --no-banner --redact --log-opts='--all' .",
    "secrets:trufflehog": "trufflehog git file://$PWD --results=verified --no-update --no-color --fail",
    "capture:demo": "bun scripts/capture-demo.ts",
    "build:plugin": "tsc -p tsconfig.build.json && bun scripts/copy-tool-texts.ts",
    "build:dev": "bun clean && bun build:plugin && vite build --mode development",
    "build:prod": "bun clean && bun build:plugin && bun run build:version && vite build --mode production",
    "prepack": "bun build:prod",
    "clean": "rm -rf dist playwright-report test-results",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "bun fmt --check",
    "format:fix": "bun fmt",
    "build:version": "bun scripts/version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@opencode/theme": "2.1.4",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "1.9.17",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "typescript": "^7.0.2",
    "@opencode/theme": ">=2.1.4",
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "opencode": ">=2.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode-ai/plugin": "1.19.4",
    "@opencode-ai/sdk": "1.19.4",
    "@opencode/plugin": "2.1.4",
    "bun-pty": "^0.5.1",
    "ghostty-web": "github:anomalyco/ghostty-web#6e24d040458ddd7aae81572fe2901deec32f9fe7",
    "open": "^11.0.4"
  },
  "patchedDependencies": {
    "ghostty-web@github:anomalyco/ghostty-web#6e24d04": "patches/ghostty-web.patch"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "seroval": "1.6.8",
    "ip-address": "10.7.4",
    "body-parser": "2.4.0",
    "undici@^8.0.0": "8.12.3",
    "undici@^6.0.0": "6.29.1",
    "zod": "4.6.7",
    "toml": "5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
