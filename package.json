{
  "name": "opencode-pty",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "version": "0.5.1",
  "description": "OpenCode plugin for interactive PTY management - run background processes, send input, read output with regex filtering",
  "author": "shekohex",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pty",
    "pseudo-terminal",
    "terminal",
    "background-process",
    "interactive",
    "cli",
    "shell",
    "dev-server",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shekohex/opencode-pty.git"
  },
  "bugs": {
    "url": "https://github.com/shekohex/opencode-pty/issues"
  },
  "homepage": "https://github.com/shekohex/opencode-pty#readme",
  "files": [
    "dist",
    "patches"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "exports": {
    "./v2": {
      "types": "./dist/src/v2/index.d.ts",
      "default": "./dist/src/v2/index.js"
    },
    "./v2/tui": {
      "types": "./dist/src/tui/index.d.ts",
      "default": "./dist/src/tui/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/src/tui/index.d.ts",
      "default": "./dist/src/tui/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    },
    "./*/*": {
      "types": "./dist/src/*/*.d.ts",
      "default": "./dist/src/*/*.js"
    },
    "./*/*/*": {
      "types": "./dist/src/*/*/*.d.ts",
      "default": "./dist/src/*/*/*.js"
    },
    "./*/*/*/*": {
      "types": "./dist/src/*/*/*/*.d.ts",
      "default": "./dist/src/*/*/*/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "unittest": "bun test --max-concurrency=1",
    "test:llm": "bun test/llm/run.ts",
    "test:coverage": "bun test --coverage --max-concurrency=1",
    "test:e2e": "PW_DISABLE_TS_ESM=1 NODE_ENV=test bun --bun playwright test",
    "test:local": "bun scripts/test-local.ts",
    "test:all": "bun run test:local",
    "aislop": "bunx aislop@0.16.1 scan . --json",
    "aislop:check": "bun scripts/check-aislop.ts",
    "deps:check": "bun scripts/check-dependencies.ts",
    "secrets:gitleaks": "gitleaks git --no-banner --redact --log-opts='--all' .",
    "secrets:trufflehog": "trufflehog git file://$PWD --results=verified --no-update --no-color --fail",
    "capture:demo": "bun scripts/capture-demo.ts",
    "build:plugin": "tsc -p tsconfig.build.json && bun x copyfiles -u 0 \"src/**/*.txt\" dist",
    "build:dev": "bun clean && bun build:plugin && vite build --mode development",
    "build:prod": "bun clean && bun build:plugin && bun run build:version && vite build --mode production",
    "prepack": "bun build:prod",
    "clean": "rm -rf dist playwright-report test-results",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "build:version": "bun scripts/version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opencode/theme": "2.0.29",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "1.9.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "typescript": "^7.0.2",
    "@opencode/theme": ">=2.0.29",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "bun": ">=1.4.2",
    "opencode": ">=1.18.31"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.19.0",
    "@opencode-ai/sdk": "^1.19.0",
    "@opencode/plugin": "^2.0.29",
    "bun-pty": "^0.5.1",
    "ghostty-web": "github:anomalyco/ghostty-web#6e24d040458ddd7aae81572fe2901deec32f9fe7",
    "open": "^11.0.4"
  },
  "patchedDependencies": {
    "ghostty-web@github:anomalyco/ghostty-web#6e24d04": "patches/ghostty-web.patch"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "seroval": "1.6.8"
  }
}
